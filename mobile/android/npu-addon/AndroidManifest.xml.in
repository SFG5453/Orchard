<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.sfg.orchard.npu.@ARCH@" android:versionCode="@VERSION_CODE@" android:versionName="@VERSION_NAME@">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />
  <!-- Libraries are extracted so Orchard can dlopen them and the DSP can read the skel. -->
  <application android:label="Orchard NPU (@ARCH_UPPER@)" android:hasCode="false" android:extractNativeLibs="true" android:allowBackup="false" />
</manifest>
