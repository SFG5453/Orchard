{
  "name": "orchard",
  "version": "5.0.0-beta.4",
  "description": "A Quasar, Vue, Socket.IO, Electron YouTube Music client backed by InnerTube.",
  "homepage": "https://github.com/sfg5453/orchard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfg5453/orchard.git"
  },
  "desktopName": "dev.sfg.orchard",
  "main": "electron/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:native && concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && node scripts/launch-electron.mjs --dev-server=http://127.0.0.1:5173\"",
    "build": "npm run build:native && npm run build:frontend",
    "build:native": "node-gyp rebuild --directory native && npm run build:native:media && sh scripts/build-native-audio.sh",
    "build:native:macos:cross": "sh scripts/build-native-macos-cross.sh",
    "build:native:windows": "sh scripts/build-native-windows.sh",
    "build:frontend": "vite build",
    "start": "npm run build:frontend && node scripts/launch-electron.mjs",
    "build:artist-pack": "node scripts/build-official-artist-pack.mjs",
    "package:linux-system": "npm run build && node scripts/package-system-electron.mjs",
    "test": "node --test test/*.test.js",
    "test:native": "node --test test/nativeAudioAnalysis.test.js test/audioAnalysisService.test.js test/smartCrossfadeAnalysis.test.js test/queueTransitionSort.test.js test/transitionPlanner.test.js test/crossfadeMixer.test.js test/autoCrossfade.test.js test/subscribedArtists.test.js test/libraryCategory.test.js",
    "fetch:beat-model": "node scripts/fetch-beat-this-model.mjs",
    "build:potoken-bundle": "node scripts/build-potoken-bundle.mjs",
    "build:native:media": "sh scripts/build-native-media.sh",
    "build:native:media:windows": "sh scripts/build-native-media-windows.sh",
    "build:native:media:macos:cross": "sh scripts/build-native-media-macos-cross.sh",
    "package:orchard": "bun run --cwd orchard-packages package:orchard",
    "package:orchard-packages:arch": "bun run --cwd orchard-packages package:arch"
  },
  "keywords": [
    "quasar",
    "vue",
    "electron",
    "innertube",
    "ytmusic"
  ],
  "author": {
    "name": "SFG545",
    "email": "sfg@sfg545.dev"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@kawarp/core": "^1.2.0",
    "@quasar/extras": "^2.0.4",
    "@vibrant/core": "^4.0.4",
    "@vibrant/generator-default": "^4.0.4",
    "@vibrant/image-browser": "^4.0.4",
    "@vibrant/quantizer-mmcq": "^4.0.4",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "bgutils-js": "4.0.3",
    "electron-window-state": "^5.0.3",
    "essentia.js": "^0.1.3",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.1",
    "idb-keyval": "^6.3.0",
    "jsdom": "30.0.1",
    "lastfm": "^0.9.4",
    "lrclib-api": "^2.1.1",
    "meyda": "^5.6.3",
    "ml-kmeans": "^7.0.1",
    "music-tempo": "^1.0.3",
    "onnxruntime-node": "^1.29.0",
    "onnxruntime-web": "^1.29.0",
    "qrcode": "^1.5.4",
    "quasar": "^2.27.0",
    "semver": "^7.8.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tar": "^7.5.22",
    "vue": "^3.5.41",
    "yauzl": "^3.4.0",
    "youtubei.js": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "electron": "43.4.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@discordjs/rest": {
      "undici": "6.27.0"
    }
  }
}
