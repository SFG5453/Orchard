{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchard",
  "version": "5.0.0-beta.6",
  "identifier": "dev.sfg.orchard",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Orchard",
        "url": "linux.html",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": ["../build/icon.png"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
