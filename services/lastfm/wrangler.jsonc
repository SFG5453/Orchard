{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This name is here for rehearsal; production has the real stage pass.
  "name": "replace-with-lastfm-worker-name",
  "main": "src/index.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Per-IP cap: every request spends the shared Last.fm API key.
  "ratelimits": [
    { "name": "LASTFM_LIMITER", "namespace_id": "9997", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
