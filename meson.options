option('tests', type: 'boolean', value: true, description: 'Build Orchard tests')
option('orchard_rust_target', type: 'string', value: '', description: 'Cargo target triple (empty uses the host)')
option('host_qjsc', type: 'string', value: '', description: 'Host qjsc built from the bundled QuickJS source for cross builds')
option('host_rcc', type: 'string', value: '', description: 'Absolute path to the host Qt resource compiler')
option('host_qsb', type: 'string', value: '', description: 'Absolute path to the host Qt shader baker')
option('adaptive_platform', type: 'string', value: '', description: 'Adaptive mix staging platform override')
option('macos_provisioning_profile', type: 'string', value: '', description: 'Provisioning profile that signs a development Orchard.app (empty skips the bundle)')
option('macos_codesign_identity', type: 'string', value: 'Apple Development', description: 'Keychain signing identity for Orchard.app, by name or SHA-1')
option('macos_distribution', type: 'boolean', value: false, description: 'Build a relocatable Orchard.app with bundled Qt, signed with the hardened runtime')
