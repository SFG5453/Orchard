{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "dev.sfg.orchard.packages",
  "applicationName": "Orchard Packages",
  "applicationIcon": "resources/icons/orchard-packages.png",
  "author": "SFG545",
  "copyright": "Copyright (C) 2026 SFG545",
  "description": "A small installer and version manager for Orchard",
  "version": "5.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.broadcast",
    "app.exit",
    "events.*",
    "extensions.*"
  ],
  "extensions": [
    {
      "id": "dev.sfg.orchard.packages.backend",
      "commandLinux": "${NL_PATH}/extensions/orchard-packages-backend",
      "commandDarwin": "${NL_PATH}/extensions/orchard-packages-backend",
      "commandWindows": "${NL_PATH}/extensions/orchard-packages-backend.exe"
    }
  ],
  "modes": {
    "window": {
      "title": "Orchard Packages",
      "width": 560,
      "height": 520,
      "minWidth": 460,
      "minHeight": 470,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/orchard-packages.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "useLogicalPixels": true
    }
  },
  "cli": {
    "binaryName": "orchard-packages",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "distributionPath": "/dist/neutralino"
  }
}
